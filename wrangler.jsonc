{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-processor",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  
  // R2 Bucket Binding - MUST match "IMAGE_BUCKET" in TypeScript
  "r2_buckets": [
    {
      "binding": "IMAGE_BUCKET",
      "bucket_name": "image-assets"
    }
  ],
  
  // D1 Database Binding - MUST match "DB" in TypeScript
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image-metadata",
      "database_id": "d5c3721b-99d6-4d7d-8a29-0bbd10985478"
    }
  ],
  
  // Workers AI Binding - MUST match "AI" in TypeScript
  "ai": {
    "binding": "AI"
  },
  
  // Optional: Enable observability
  "observability": {
    "enabled": true
  }
}